{
  "name": "DTU Course Analyzer",
  "description": "Analyzes and scores courses on kurser.dtu.dk/xxxxx",
  "version": "2.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://kurser.dtu.dk/course/*",
        "https://kurser.dtu.dk/course/*"
      ],
      "js": [
        "js/jquery.js",
        "contentscript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/jquery.js",
        "js/contentscript.js"
      ],
      "matches": [
        "http://kurser.dtu.dk/*",
        "https://kurser.dtu.dk/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icons/48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dtu.course.analyzer@gmail.com"
    }
  },
  "applications": {
    "gecko": {
      "id": "mathias@smkid.dk",
      "strict_min_version": "52.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://seb-sti1.github.io/dtu-course-analyzer/data.json"
  ]
}